        <body>
            <cb type="single-column"/>
            <head><hi rend="rubrique">Dezir q<ex>ue</ex> fixo Diego de burgos
                        <lb break="yes"/>secretario del Marques de Santi<lb
                        break="no"/>llana al Rey de portugal</hi></head>
            <lg n="1">
                <l><lb break="yes"/>Digno Rey para la tierra</l>
                <l><lb break="yes"/>Nue<subst hand="#self">
                        <del>u</del>
                        <add>b</add>
                    </subst>o sole en ocidente</l>
                <l><lb break="yes"/>se q<ex>ue</ex> mi lengua no yerra</l>
                <l><lb break="yes"/>si del bie<ex>n</ex> q<ex>ue</ex> en vos se
                    encierra</l>
                <l><lb break="yes"/>fablara publicame<ex>n</ex>te</l>
            </lg>
        </body>
