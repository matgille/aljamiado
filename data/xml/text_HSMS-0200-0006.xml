    <text>
        <body>
            <cb type="single-column"/>
            <div type="poeme">
                <head><hi rend="rubrique">Otras suyas del Marques <lb
                            break="yes"/>a n<ex>uest</ex>ra Señora</hi></head>
                <pb n="92v"/>
                <cb type="single-column"/>
                <lg n="1">
                    <l><lb break="yes"/>Virgen eternal esposa </l>
                    <l><lb break="yes"/>del padre q<ex>ue</ex> dabenicio </l>
                    <l><lb break="yes"/>te crio por beneficio </l>
                    <l><lb break="yes"/>desta vida congoxa </l>
                    <l><lb break="yes"/>del jardin sagrada rosa </l>
                    <l><lb break="yes"/>y preciosa margarita </l>
                    <l><lb break="yes"/>fontana dagua bendita </l>
                    <l><lb break="yes"/>fulgor de gracia ynfenita </l>
                    <l><lb break="yes"/>por man de dios escrita </l>
                    <l><lb break="yes"/>y domina gloriosa </l>
                </lg>
                <lg n="2">
                    <l><lb break="yes"/>Fertil oliua y specios </l>
                    <l><lb break="yes"/>en los canpos de syon </l>
                    <l><lb break="yes"/>cantica de Salamon </l>
                    <l><lb break="yes"/>tu plaza de real mina </l>
                    <l><lb break="yes"/>de presa pia generosa </l>
                    <l><lb break="yes"/>eleta por santa y diuina </l>
                    <l><lb break="yes"/>en la p<ex>re</ex>sencia diuina </l>
                    <l><lb break="yes"/>a quien el sielo s<choice>
                            <corr> </corr>
                            <sic/>
                        </choice>enclyna </l>
                    <l><lb break="yes"/>como a Reyna poderosa </l>
                </lg>
                <lg n="3">
                    <head><lb break="yes"/><hi rend="rubrique">Fyn</hi>
                        <pb n="93r"/>
                        <cb type="single-column"/></head>
                    <l><lb break="yes"/>Ynue<ex>n</ex>zible vituriosa </l>
                    <l><lb break="yes"/>de n<ex>uest</ex>ros
                        p<ex>er</ex>seguidores </l>
                    <l><lb break="yes"/>Refrigro de pecadores </l>
                    <l><lb break="yes"/>pausa de todos dolores </l>
                    <l><lb break="yes"/>pues tu fyn es de largores </l>
                    <l><lb break="yes"/>madre misericordiosa </l>
                </lg>
            </div>
            <div type="poeme">
                <!--Revoir la division en strophes.-->
                <head><lb break="yes"/><hi rend="rubrique">Otras suyas del Señor
                            <lb break="yes"/>Marq<ex>ue</ex>s a n<ex>uest</ex>ra
                        Señora</hi>
                </head>
                <lg n="1">
                    <l><lb break="yes"/>Inefable mas fermosa </l>
                    <l><lb break="yes"/>q<ex>ue</ex> todas las mas fermosas </l>
                    <l><lb break="yes"/>tesoro de santas cosas </l>
                    <l><lb break="yes"/>Flor de bla<ex>n</ex>co lylio / o / rosa </l>
                    <l><lb break="yes"/>abondante frutuosa </l>
                    <l><lb break="yes"/>de perfeta Calidad </l>
                    <l><lb break="yes"/>palma de gra<ex>n</ex> humildad </l>
                    <l><lb break="yes"/>esfuerzo de humanidad </l>
                    <l><lb break="yes"/>Armas de la trenidad </l>
                    <l><lb break="yes"/>En qual q<ex>u</ex><hi
                            rend="superscript">i</hi>era tie<ex>n</ex>po
                        espantosa <pb n="93v"/>
                        <cb type="single-column"/></l>
                </lg>
                <lg n="2">
                    <l><lb break="yes"/>Tu caridad piadosa </l>
                    <l><lb break="yes"/>vmana beninidad </l>
                    <l><lb break="yes"/>serena serenidad </l>
                    <l><lb break="yes"/>vida honesta religiosa </l>
                    <l><lb break="yes"/>la sente<ex>n</ex>cia regurosa </l>
                    <l><lb break="yes"/>causada por la mujer </l>
                    <l><lb break="yes"/>en fauor de Lucifer </l>
                    <l><lb break="yes"/>torno de ser a no ser </l>
                    <l><lb break="yes"/>quie<ex>n</ex> es q<ex>u</ex><hi
                            rend="superscript">a</hi>l pudo hazer </l>
                    <l><lb break="yes"/>obra tan marauillosa </l>
                </lg>
                <lg n="3">
                    <!--Cette strophe n'a que neuf vers-->
                    <l><lb break="yes"/>De los radios radiosa </l>
                    <l><lb break="yes"/>estrella su rebatia </l>
                    <l><lb break="yes"/>Fiesta de la efania </l>
                    <l><lb break="yes"/>bluuio teta copiosa </l>
                    <l><lb break="yes"/>testos admirable cosa </l>
                    <l><lb break="yes"/>y santos de los profetos </l>
                    <l><lb break="yes"/>pañes de n<ex>uest</ex>ras saetas </l>
                    <l><lb break="yes"/>perficion de las co<ex>n</ex>pletas </l>
                    <l><lb break="yes"/>Enperatriz valerosa <pb n="94r"/>
                        <cb type="single-column"/></l>
                </lg>
                <lg n="4">
                    <l><lb break="yes"/>Celestial lunbre lunbrosa </l>
                    <l><lb break="yes"/>nuevo sol en guadalupe </l>
                    <l><lb break="yes"/>persona sy mas no supe </l>
                    <l><lb break="yes"/>mi lengua defetuosa </l>
                    <l><lb break="yes"/>ninguna fue ta<ex>n</ex> fermosa </l>
                    <l><lb break="yes"/>en los n<ex>uest</ex>ros precesores </l>
                    <l><lb break="yes"/>santos ni sabios dotores </l>
                    <l><lb break="yes"/>q<ex>ue</ex> en loar los tus loores </l>
                    <l><lb break="yes"/>no le recrescen errores </l>
                    <l><lb break="yes"/>Fuese rima fuesa prosa </l>
                </lg>
            </div>
        </body>
    </text>
